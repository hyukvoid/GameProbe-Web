# Copy to .env.local for local development. Never commit real values.

# Postgres connection used by the server only.
# Local (npm run db:local):  postgres://postgres:postgres@127.0.0.1:54329/postgres
# Supabase: Project Settings > Database > Connection string (transaction pooler, port 6543),
#           append ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Admin sign-in for /admin. At least 16 characters. Admin is disabled if unset.
ADMIN_PASSWORD=

# Signs the admin session cookie and keys submitter hashes. At least 32 random characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
APP_SECRET=

# Show development fixtures (db/fixtures/dev.sql). Local only.
SHOW_DEMO_DATA=false
